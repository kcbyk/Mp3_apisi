# =============================================================================
#  arena-proxy — .env.example
#  Kullanım: cp .env.example .env  &&  .env dosyasını doldur
#  NOT: Gerçek .env dosyasını ASLA git'e commit etme (bkz. .gitignore).
# =============================================================================

# ----------------------------------------------------------------------------
# 1) SERVİS / HTTP
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# JSON log yerine insan-okur log için: LOG_PRETTY=true (yalnızca development)
LOG_PRETTY=false
# Üst katmanların bizim loglarımızı görebilmesi için CORS origin listesi (* = hepsi)
CORS_ORIGINS=*
# /metrics, /health gibi uçlar için prefix
API_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# 2) KİMLİK DOĞRULAMA (bizim API'mizin istemcileri)
# ----------------------------------------------------------------------------
# Virgülle ayrılmış API anahtarları. Boş bırakılırsa /api/v1/* AÇIK olur (sadece dev!).
API_KEYS=dev-key-change-me
# true ise Authorization: Bearer <key> veya x-api-key: <key> zorunlu
AUTH_ENABLED=true

# ----------------------------------------------------------------------------
# 3) TARAYICI (Playwright / Chromium)
# ----------------------------------------------------------------------------
BROWSER_HEADLESS=true
# Gizli modlarda Cloudflare skorunu artırmak için: channel=chromium (yeni headless)
# Docker/Linux'ta xvfb-run + BROWSER_HEADLESS=false kombinasyonu genelde daha iyi sonuç verir.
BROWSER_CHANNEL=
# Aynı anda yaşayacak browser context sayısı (bellek ≈ 120-250 MB / context)
MAX_CONTEXTS=3
# Bir context kaç istekten sonra geri dönüştürülecek (bellek sızıntısı önlemi)
MAX_PAGES_PER_CONTEXT=25
# Context maksimum yaşı (ms) — süre sonunda yenisi açılır
CONTEXT_MAX_AGE_MS=900000
# Chromium process maksimum yaşı (ms) — süre sonunda graceful restart
BROWSER_MAX_AGE_MS=3600000
# true ise context'ler kalıcı profil dizininden açılır (cookie/localStorage diske yazılır)
PERSISTENT_PROFILE=false
PROFILE_BASE_DIR=./data/profiles
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
# Selenium/Cf tespitini azaltan argümanlar (virgülle ayrılmış ek argümanlar)
EXTRA_CHROMIUM_ARGS=
# Ağır kaynakları engelle (görselleri ENGELLEME — üretilen asset URL'i response olayından
# yakalanır; DİKKAT: engellenen istek için response event'i tetiklenmez).
BLOCK_URL_PATTERNS=google-analytics.com,googletagmanager.com,doubleclick.net,hotjar.com,segment.io,fullstory.com,facebook.net
BLOCK_FONTS=false
BLOCK_MEDIA=false
# İstek başına toplam tarayıcı işi üst sınırı (ms)
NAVIGATION_TIMEOUT_MS=45000

# ----------------------------------------------------------------------------
# 4) OTURUM (Cookie / LocalStorage / storageState)
# ----------------------------------------------------------------------------
# storage  → her context'e session dosyası enjekte edilir (önerilen, izole)
# profile   → kalıcı tarayıcı profili kullanılır (data/profiles/ctx-*)
SESSION_MODE=storage
SESSION_STATE_PATH=./data/sessions/arena.json
# Session dosyası bu aralıkla diskten yeniden okunur (canlı güncelleme)
SESSION_RELOAD_INTERVAL_MS=60000
# Oturum düşmüşse (login wall) isteği bu hata koduyla döndür
SESSION_MISSING_STATUS=503

# ----------------------------------------------------------------------------
# 5) STEALTH / ANTI-BOT
# ----------------------------------------------------------------------------
STEALTH_ENABLED=true
# playwright-extra stealth eklenti setini uygular (navigator.webdriver, chrome.runtime vb.)
STEALTH_EVASIONS=
# Kullanıcı etkileşimlerini insanlaştır (yazma gecikmesi, mouse jitterı)
HUMANIZE=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
LOCALE=tr-TR
TIMEZONE=Europe/Istanbul
# cf_clearance gibi cookie'ler IP + UA'ya bağlıdır: proxy kullanıyorsan UA ve IP tutarlı olmalı.
ACCEPT_LANGUAGE=tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7

# ----------------------------------------------------------------------------
# 6) PROXY (hedef platforma çıkış trafiği)
# ----------------------------------------------------------------------------
PROXY_ENABLED=false
PROXY_SERVER=http://user:pass@proxy-host:8080
PROXY_USERNAME=
PROXY_PASSWORD=
# Proxy'den geçmemesi gereken adresler (tarayıcı ile aynı makinedeki servisler vb.)
PROXY_BYPASS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# 7) KUYRUK / CONCURRENCY
# ----------------------------------------------------------------------------
# Aynı anda işlenecek istek sayısı (MAX_CONTEXTS ile tutarlı tutun)
QUEUE_CONCURRENCY=2
# Kuyrukta bekleyebilecek maksimum istek; aşılırsa 429 döner
MAX_QUEUE_SIZE=50
# Dakikada en fazla başlatılacak iş (0 = otomatik: concurrency x 6)
QUEUE_RATE_PER_MIN=0
# Tek bir işin (navigate + generate + indirme) toplam üst sınırı
JOB_TIMEOUT_MS=120000
# Kuyrukta bekleme üst sınırı
QUEUE_WAIT_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------
# 8) RETRY / DAYANIKLILIK
# ----------------------------------------------------------------------------
RETRY_ATTEMPTS=2
RETRY_MIN_TIMEOUT_MS=1000
RETRY_MAX_TIMEOUT_MS=8000
# Yeniden denemeye değer hatalar (virgülle)
RETRY_ON=NavigationError,TimeoutError,ArtifactNotFoundError,BrowserClosedError

# ----------------------------------------------------------------------------
# 9) SCRAPER / SEÇİCİLER
# ----------------------------------------------------------------------------
TARGET_NAME=arena
TARGET_BASE_URL=https://arena.ai
# Asset üretim aracının yolu (örn. /image, /studio, /create)
TARGET_GENERATE_PATH=/
# Seçici dosyası (resilient selector registry) — gerekirse override et
SELECTORS_PATH=./src/scrapers/selectors/arena.json
# Sadece bu host'lara navigasyon izinli (SSRF koruması, boş = kapalı)
ALLOWED_NAV_HOSTS=arena.ai,www.arena.ai
STEP_TIMEOUT_MS=20000
GENERATION_TIMEOUT_MS=90000
# Generate sonrası asset URL'i beklenirken ilk kontrol / toplam süre
ARTIFACT_POLL_INTERVAL_MS=500
# Üretim tamamlanana kadar beklenen progress/DOM sinyalleri
WAIT_FOR_DOM_RESULT=true
SCREENSHOT_ON_ERROR=true
SCREENSHOT_DIR=./data/screenshots
# Tarayıcı olmadan uçtan uca API testi (CI/demo): true ise fixture döner
DRY_RUN=false

# ----------------------------------------------------------------------------
# 10) ÇIKTI TESLİMİ (artifact delivery)
# ----------------------------------------------------------------------------
# url    → CDN/S3 linkini JSON'da döndür (en hızlı, link expire edebilir)
# base64 → görseli indirip base64 göm (büyük payload)
# file   → indirip diske yaz, servisin kendi URL'ini döndür
# both   → url + base64
ARTIFACT_DELIVERY=url
ARTIFACT_LOCAL_DIR=./data/artifacts
# Servis edilen dosyaların public tabanı (file delivery için)
ARTIFACT_PUBLIC_BASE_URL=http://localhost:8080/files/artifacts
MAX_DOWNLOAD_BYTES=26214400
# İndirilebilecek host allowlist'i (boş = sadece TARGET + .amazonaws.com/.cloudfront.net yıldızlı)
ALLOWED_ASSET_HOSTS=
DELETE_ARTIFACT_AFTER_MS=86400000
